# Configurações opcionais para a execução local.
# Copie para .env se quiser alterar os padrões.
#
# O Docker Compose gera um segredo JWT aleatório em um volume persistente.
# Para usar um segredo próprio, gere 48 bytes aleatórios e defina:
# JWT_SEGREDO=
TOKEN_MINUTOS=60
DADOS_EXEMPLO=1
SENHA_EXEMPLO=Helpdesk2026
DOCS=1
